<% if (success && success.length) { %>
  <% success.forEach((message) => { %>
    <div class="alert flash-alert alert-dismissible fade show" role="status">
      <span class="flash-alert-icon" aria-hidden="true"><i class="fa-solid fa-circle-check"></i></span>
      <span><%= message %></span>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Dismiss notification"></button>
    </div>
  <% }) %>
<% } %>
<% if (error && error.length) { %>
  <% error.forEach((message) => { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <%= message %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Dismiss notification"></button>
    </div>
  <% }) %>
<% } %>
