<nav class="navbar navbar-expand-md navbar-light bg-light border-bottom sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand" href="/listings"><i class="fa-regular fa-compass"></i></a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup" >
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-nav navbar-links">
        <a class="nav-link" href="/listings">Explore</a>
        <a class="nav-link" href="/listings/new">Become a host</a>
       
      </div>
      <form class="navbar-search" action="/listings" method="GET" role="search">
        <label class="visually-hidden" for="navbar-search-query">Search stays and locations</label>
        <input
          id="navbar-search-query"
          type="search"
          name="q"
          value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
          placeholder="Search stays or places"
          autocomplete="off"
        >
        <label class="visually-hidden" for="navbar-search-category">Stay type</label>
        <select id="navbar-search-category" name="category" aria-label="Stay type">
          <option value="all" <%= typeof searchCategory === 'undefined' || searchCategory === 'all' ? 'selected' : '' %>>All stays</option>
          <option value="hotels" <%= typeof searchCategory !== 'undefined' && searchCategory === 'hotels' ? 'selected' : '' %>>Hotels</option>
          <option value="homes" <%= typeof searchCategory !== 'undefined' && searchCategory === 'homes' ? 'selected' : '' %>>Homes</option>
          <option value="villas" <%= typeof searchCategory !== 'undefined' && searchCategory === 'villas' ? 'selected' : '' %>>Villas</option>
          <option value="beach" <%= typeof searchCategory !== 'undefined' && searchCategory === 'beach' ? 'selected' : '' %>>Beach stays</option>
          <option value="mountain" <%= typeof searchCategory !== 'undefined' && searchCategory === 'mountain' ? 'selected' : '' %>>Mountain stays</option>
          <option value="cabins" <%= typeof searchCategory !== 'undefined' && searchCategory === 'cabins' ? 'selected' : '' %>>Cabins</option>
          <option value="lake" <%= typeof searchCategory !== 'undefined' && searchCategory === 'lake' ? 'selected' : '' %>>Lake stays</option>
          <option value="apartments" <%= typeof searchCategory !== 'undefined' && searchCategory === 'apartments' ? 'selected' : '' %>>Apartments</option>
        </select>
        <button type="submit" aria-label="Search listings"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
      </form>
      <div class="navbar-nav ms-auto align-items-md-center">
        <% if (currentUser) { %>
          <span class="nav-link auth-nav-greeting">Hi, <%= currentUser.username %></span>
          <form action="/logout" method="POST" class="d-flex">
            <button class="btn btn-outline-dark btn-sm auth-nav-button" type="submit">Log out</button>
          </form>
        <% } else { %>
          <a class="nav-link" href="/login">Log in</a>
          <a class="btn auth-nav-button" href="/signup">Sign up</a>
        <% } %>
      </div>
    </div>
  </div>
</nav>
